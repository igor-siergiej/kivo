{
  "repoName": "kivo",
  "dev": {
    "startCommand": "docker compose -f docker-compose.test.yml up -d --wait && PORT=3008 CONNECTION_URI='mongodb://localhost:27018/?directConnection=true' DATABASE_NAME=kivo_e2e JWT_SECRET=e2e-secret-e2e-secret-e2e-secret-0123 ACCESS_TOKEN_EXPIRY=15m REFRESH_TOKEN_EXPIRY=7d SECURE=false SAME_SITE=Lax bun src/index.ts",
    "healthCheckUrl": "http://localhost:3008/health",
    "healthCheckTimeoutMs": 60000,
    "healthCheckIntervalMs": 2000,
    "teardownCommand": "docker compose -f docker-compose.test.yml down -v"
  },
  "e2e": {
    "testCommand": "bash scripts/e2e.sh",
    "smokeGrep": "@smoke"
  },
  "ci": {
    "workflowNames": ["PR Checks"],
    "checkNamesRequired": ["lint", "test"]
  },
  "deploy": {
    "workflowName": "CI/CD",
    "timeoutMs": 900000,
    "pollIntervalMs": 15000
  },
  "environments": {
    "production": { "baseUrl": "https://kivo.imapps.uk" }
  },
  "targetEnvironment": "production",
  "retryPolicy": { "implement": 3, "e2e_local": 3, "ci": 3, "deploy": 2, "e2e_live": 1 },
  "github": { "defaultBranch": "main", "mergeMethod": "squash" }
}
