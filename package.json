{
  "name": "kivo",
  "version": "1.14.1",
  "type": "module",
  "repository": "https://github.com/igor-siergiej/kivo",
  "author": "Igor Siergiej <igorsiergiej@gmail.com>",
  "scripts": {
    "start": "bun --hot src/index.ts",
    "build": "bun build src/index.ts --outdir build --target=bun",
    "test": "bun test",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt && oxlint",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "prepare": "husky || true",
    "release": "semantic-release"
  },
  "dependencies": {
    "@imapps/api-utils": "0.11.0",
    "hono": "^4.13.13",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.21.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@imapps/oxc-config": "file:../oxc-config-local.tgz",
    "@oxlint/plugins": "1.90.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/bun": "^1.4.2",
    "@types/jsonwebtoken": "^9.0.2",
    "husky": "^9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "semantic-release": "^24.2.0",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,jsx}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.json": "oxfmt --no-error-on-unmatched-pattern"
  },
  "module": "src/index.ts",
  "private": true,
  "overrides": {
    "lodash-es": "4.17.23"
  }
}
