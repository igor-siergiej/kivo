PORT=3008
DATABASE_NAME=auth
CONNECTION_URI=mongodb://devuser:devpassword@localhost:27017/auth?authSource=admin
JWT_SECRET=change-me-use-at-least-32-random-characters
ACCESS_TOKEN_EXPIRY=1m
REFRESH_TOKEN_EXPIRY=10m
SECURE=false
SAME_SITE=lax

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000,http://shoppingo.imapps.staging,http://jewellerycatalogue.imapps.staging,https://shoppingo.imapps.co.uk,https://jewellerycatalogue.imapps.co.uk

# Require auth on /users and /search (set true once consumers send credentials)
LOOKUP_AUTH_ENABLED=false
# Shared secret for server-to-server /users calls via X-Service-Token
SERVICE_TOKEN=

# Optional EC P-256 (ES256) private key, PKCS8 PEM (\n escapes allowed). Enables JWKS at /.well-known/jwks.json
# Generate: openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt
JWT_PRIVATE_KEY=
